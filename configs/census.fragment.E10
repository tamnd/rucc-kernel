# The census fragment for era E10, merged into allmodconfig for rk demands and rk asm-inventory.
#
# allmodconfig turns on COMPILE_TEST, and with it DWARF for every unit, which takes the build tree
# past the disk of a hosted runner. The census counts what each unit asks of the compiler, and a
# defconfig build with the test fragment already asks for DWARF, so this turns it off here.

CONFIG_DEBUG_INFO_NONE=y

# arm64 allmodconfig builds gcc's kernel with generic KASAN, UBSAN and the shadow call stack, and
# rucc's without them, since rucc takes no -fsanitize flag. That puts the instrumentation in every
# unit of one build only, and the sections, symvers and flags differentials then compare that and
# nothing else. Plan section 8.10 keeps the sanitizers out of the grade, so the census turns them
# off in both builds. KCSAN goes too, since allmodconfig turns it on once KASAN is off.

# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_KCSAN is not set
