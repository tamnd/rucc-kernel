# The census fragment for era E11, merged into allmodconfig for rk demands and rk asm-inventory.
#
# allmodconfig turns on COMPILE_TEST, and with it DWARF for every unit, which takes the build tree
# past the disk of a hosted runner. The census counts what each unit asks of the compiler, and a
# defconfig build with the test fragment already asks for DWARF, so this turns it off here.

CONFIG_DEBUG_INFO_NONE=y

# 7.2 no longer asks the compiler before it offers KCOV, so allmodconfig passes
# -fsanitize-coverage=trace-pc to every unit and rucc refuses it on each one, which hides every
# other demand behind it. Plan section 8.10 keeps KCOV out of the grade, so the census leaves it out.

# CONFIG_KCOV is not set
